{
  "schema_version": 1,
  "description": "Exhaustive list of files that may enter a Phase 3.2 agent project. Paths are relative to evaluations/phase-3.2/. Anything not listed here is never copied.",
  "categories": {
    "immutable": "Must be byte-identical before and after the run. Root-owned and read-only inside the run.",
    "mutable": "The one file the task asks the agent to change. Owned by the agent user.",
    "additive": "Existing file inside an additive directory. The agent may change it or add siblings."
  },
  "additive_dirs": ["tests/additive"],
  "protected_dirs": ["tests/baseline"],
  "tolerated_artifacts": ["__pycache__", ".pytest_cache"],
  "common_files": {
    "opencode.jsonc": {"source": "config/opencode.jsonc", "category": "immutable"}
  },
  "test_command": ["python3", "-m", "unittest", "discover", "-s", "tests", "-t", ".", "-v"],
  "tasks": {
    "SMOKE": {
      "title": "Harness smoke check (runtime gates only; never scored)",
      "source_dir": "tasks/SMOKE/project",
      "files": {
        "README.md": "immutable",
        "TASK.md": "immutable",
        "notes.txt": "mutable"
      }
    },
    "NEW-01": {
