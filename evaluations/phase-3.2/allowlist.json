        "webhooks/outbox.py": "immutable",
        "webhooks/store.py": "immutable",
        "webhooks/types.py": "immutable",
        "tests/__init__.py": "immutable",
        "tests/baseline/__init__.py": "immutable",
        "tests/baseline/test_webhooks_baseline.py": "immutable",
        "tests/additive/__init__.py": "additive"
      }
    },
    "NEW-02": {
