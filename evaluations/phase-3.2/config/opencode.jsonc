{
  "$schema": "https://opencode.ai/config.json",
  // Byte-identical in every control and treatment run.
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "question", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": "TASK.md", "effect": "deny" },
    { "action": "edit", "resource": "README.md", "effect": "deny" },
    { "action": "edit", "resource": "tests/baseline/*", "effect": "deny" }
  ]
}
